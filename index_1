                        cb.type = 'checkbox';
                        cb.checked = map.hasLayer(it.layer);
                        var sw = L.DomUtil.create('span', 'sw ' + it.sw, row);
                        if (it.bg) sw.style.background = it.bg;
                        var lbl = L.DomUtil.create('span', 'lbl', row);
                        lbl.textContent = it.label;
                        cb.onchange = function () {
                            if (cb.checked) { map.addLayer(it.layer); } else { map.removeLayer(it.layer); }
                            row.classList.toggle('off', !cb.checked);
                        };
                    });
                });
                L.DomUtil.create('div', 'lg-note', body).textContent = 'Hapus centang untuk menyembunyikan layer. Luas dan panjang dihitung otomatis dari geometri (perkiraan).';
                L.DomEvent.disableClickPropagation(box);
                L.DomEvent.disableScrollPropagation(box);
                return box;
            }
