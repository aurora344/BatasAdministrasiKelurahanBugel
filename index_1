        /* =====================================================
           POPUP: fungsi bantu (luas, panjang, format angka)
           ===================================================== */
        var NAMA_KELURAHAN = 'Bugel';
        var WARNA_RW = {
            1: 'rgb(215,25,28)',
            2: 'rgb(237,110,67)',
            3: 'rgb(253,186,111)',
            4: 'rgb(254,232,165)',
            5: 'rgb(230,244,167)',
            6: 'rgb(179,222,118)',
            7: 'rgb(106,188,88)'
        };
        function rad(d) { return d * Math.PI / 180; }
        // Luas geodesik (m²) dari ring koordinat WGS84 [lon, lat]
        function ringArea(c) {
            var a = 0, R = 6378137, n = c.length;
            if (n < 3) return 0;
            for (var i = 0; i < n; i++) {
                var p1 = c[i], p2 = c[(i + 1) % n];
                a += rad(p2[0] - p1[0]) * (2 + Math.sin(rad(p1[1])) + Math.sin(rad(p2[1])));
            }
            return Math.abs(a * R * R / 2);
        }
        function polyArea(rings) {
            var a = ringArea(rings[0]);
            for (var i = 1; i < rings.length; i++) a -= ringArea(rings[i]);
            return a;
        }
        function luasGeometri(g) {
            if (!g) return 0;
            if (g.type === 'Polygon') return polyArea(g.coordinates);
            if (g.type === 'MultiPolygon') return g.coordinates.reduce(function (s, p) { return s + polyArea(p); }, 0);
            return 0;
        }
        // Panjang (m) garis WGS84 dengan rumus haversine
        function panjangLine(c) {
            var d = 0;
            for (var i = 1; i < c.length; i++) {
                var la1 = rad(c[i-1][1]), la2 = rad(c[i][1]);
                var dla = la2 - la1, dlo = rad(c[i][0] - c[i-1][0]);
                var h = Math.sin(dla/2) * Math.sin(dla/2) + Math.cos(la1) * Math.cos(la2) * Math.sin(dlo/2) * Math.sin(dlo/2);
                d += 2 * 6371008.8 * Math.asin(Math.sqrt(h));
            }
            return d;
        }
        function panjangGeometri(g) {
            if (!g) return 0;
            if (g.type === 'LineString') return panjangLine(g.coordinates);
            if (g.type === 'MultiLineString') return g.coordinates.reduce(function (s, l) { return s + panjangLine(l); }, 0);
            if (g.type === 'Polygon') return panjangLine(g.coordinates[0]);
            if (g.type === 'MultiPolygon') return g.coordinates.reduce(function (s, p) { return s + panjangLine(p[0]); }, 0);
            return 0;
        }
        function fmt(n, d) { return n.toLocaleString('id-ID', {minimumFractionDigits: d, maximumFractionDigits: d}); }
        function fmtPanjang(m) { return m >= 1000 ? fmt(m / 1000, 2) + ' km' : fmt(m, 0) + ' m'; }
        function nomorRW(v) {
            var m = String(v == null ? '' : v).match(/\d+/);
            return m ? parseInt(m[0], 10) : null;
        }
        function kartu(warna, jenis, judul, baris) {
            var rows = baris.map(function (b) { return '<tr><th>' + b[0] + '</th><td>' + b[1] + '</td></tr>'; }).join('');
            return '<div class="pc-strip" style="background:' + warna + '"></div>' +
                   '<div class="pc-body">' +
                   '<p class="pc-type">' + jenis + '</p>' +
                   '<div class="pc-title"><span class="pc-dot" style="background:' + warna + '"></span>' + judul + '</div>' +
                   '<table class="pc-table">' + rows + '</table></div>';
        }
        var POPUP_OPT = {maxHeight: 400, className: 'pop-card'};

        // Popup untuk semua layer batas RW
        function popupRW(feature, layer) {
            var no = nomorRW(feature.properties['RW_1']);
            var warna = WARNA_RW[no] || '#888';
            var judul = no ? 'RW ' + (no < 10 ? '0' + no : no) : (feature.properties['RW_1'] || 'RW');
            var ha = luasGeometri(feature.geometry) / 10000;
            var baris = [
                ['Kelurahan', NAMA_KELURAHAN],
                ['Luas wilayah', '± ' + fmt(ha, 2) + ' ha'],
                ['Keliling batas', '± ' + fmtPanjang(panjangGeometri(feature.geometry))]
            ];
            layer.bindPopup(kartu(warna, 'Rukun Warga', judul, baris), POPUP_OPT);
        }
        // Popup untuk layer garis (jalan, sungai)
        function popupGaris(jenis, judul, warna) {
            return function (feature, layer) {
                var baris = [
                    ['Kategori', jenis],
                    ['Panjang segmen', '± ' + fmtPanjang(panjangGeometri(feature.geometry))],
                    ['Lokasi', 'Kel. ' + NAMA_KELURAHAN]
                ];
                layer.bindPopup(kartu(warna, jenis, judul, baris), POPUP_OPT);
            };
        }

