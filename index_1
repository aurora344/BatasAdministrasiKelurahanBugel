        <style>
        :root {
            --ink: #1E2A23;
            --muted: #5B6A61;
            --rule: #D5DDD7;
            --paper: #FFFFFF;
            --tint: #F3F6F4;
            --font: 'Plus Jakarta Sans', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        }
        html, body, #map {
            width: 100%;
            height: 100%;
            padding: 0;
            margin: 0;
        }
        body { font-family: var(--font); color: var(--ink); }
        .leaflet-container { font-family: var(--font); }

        /* ---------- Judul ---------- */
        .map-title {
            position: absolute;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 1000;
            background: var(--paper);
            border: 1px solid var(--ink);
            box-shadow: 4px 4px 0 rgba(30,42,35,.85);
            padding: 10px 18px 11px;
            text-align: center;
            max-width: calc(100% - 140px);
            box-sizing: border-box;
            pointer-events: none;
        }
        .map-title h1 {
            margin: 0;
            font-size: 19px;
            line-height: 1.25;
            font-weight: 700;
            letter-spacing: -0.01em;
        }
        .map-title p {
            margin: 3px 0 0;
            font-size: 12.5px;
            color: var(--muted);
        }

        /* ---------- Popup ---------- */
        .pop-card .leaflet-popup-content-wrapper {
            padding: 0;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 6px 22px rgba(0,0,0,.28);
        }
        .pop-card .leaflet-popup-content { margin: 0; min-width: 210px; }
        .pop-card a.leaflet-popup-close-button { color: var(--muted); top: 10px; right: 6px; }
        .pc-strip { height: 7px; }
        .pc-body { padding: 11px 16px 13px; }
        .pc-type { font-size: 12px; color: var(--muted); margin: 0; }
        .pc-title {
            font-size: 20px;
            font-weight: 700;
            margin: 1px 0 9px;
            line-height: 1.2;
            display: flex;
            align-items: center;
            gap: 9px;
        }
        .pc-dot { width: 14px; height: 14px; border-radius: 3px; border: 1px solid rgba(0,0,0,.35); flex: none; }
        .pc-table { width: 100%; border-collapse: collapse; font-size: 13px; }
        .pc-table th, .pc-table td { padding: 5px 0; border-top: 1px solid var(--rule); text-align: left; vertical-align: top; }
        .pc-table th { font-weight: 500; color: var(--muted); width: 45%; padding-right: 10px; }
        .pc-table td { font-weight: 600; }

        /* ---------- Legenda ---------- */
        .legend {
            background: var(--paper);
            border: 1px solid var(--ink);
            box-shadow: 4px 4px 0 rgba(30,42,35,.85);
            width: 236px;
            max-height: calc(100vh - 120px);
            display: flex;
            flex-direction: column;
            font-size: 13px;
        }
        .legend-toggle {
            all: unset;
            box-sizing: border-box;
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
            padding: 9px 13px;
            font-weight: 700;
            font-size: 14px;
            cursor: pointer;
            border-bottom: 1px solid var(--ink);
        }
        .legend-toggle:focus-visible { outline: 2px solid #2F7DE1; outline-offset: -3px; }
        .legend-toggle .chev { transition: transform .2s; font-size: 11px; }
        .legend.collapsed .legend-toggle { border-bottom: 0; }
        .legend.collapsed .legend-toggle .chev { transform: rotate(-90deg); }
        .legend.collapsed .legend-body { display: none; }
        .legend-body { overflow-y: auto; padding: 4px 0 8px; }
        .lg-group { padding: 6px 13px 2px; }
        .lg-group + .lg-group { border-top: 1px solid var(--rule); margin-top: 4px; }
        .lg-head { font-size: 12px; font-weight: 600; color: var(--muted); margin: 2px 0 4px; }
        .lg-item {
            display: flex;
            align-items: center;
            gap: 9px;
            padding: 3px 4px;
            margin: 0 -4px;
            border-radius: 4px;
            cursor: pointer;
            user-select: none;
        }
        .lg-item:hover { background: var(--tint); }
        .lg-item input { margin: 0; accent-color: var(--ink); cursor: pointer; }
        .lg-item.off .sw, .lg-item.off span.lbl { opacity: .35; }
        .sw { width: 26px; height: 14px; flex: none; box-sizing: border-box; }
        .sw-fill { border: 1px solid rgb(35,35,35); }
        .sw-line { height: 6px; border-top: 1px solid #000; border-bottom: 1px solid #000; }
        .sw-water { height: 6px; border-top: 1px solid rgb(0,255,255); border-bottom: 1px solid rgb(0,255,255); background: rgb(204,255,255); }
        .sw-batas {
            height: 4px;
            background: repeating-linear-gradient(90deg, rgb(128,128,128) 0 10px, rgb(255,255,191) 10px 15px);
            outline: 1px solid rgb(255,255,191);
        }
        .sw-sat { background: linear-gradient(135deg, #3f5a2c, #6f7f4a 45%, #9a8f6a 70%, #4c6a3a); border: 1px solid rgba(0,0,0,.4); }
        .lg-note { font-size: 11.5px; color: var(--muted); padding: 8px 13px 0; line-height: 1.4; }

        @media (max-width: 600px) {
            .map-title { top: 10px; left: 56px; right: 10px; transform: none; max-width: none; padding: 8px 12px; text-align: left; }
            .map-title h1 { font-size: 15px; }
            .map-title p { font-size: 11.5px; }
            .legend { width: 210px; max-height: calc(100vh - 150px); }
        }
        @media (prefers-reduced-motion: reduce) { .legend-toggle .chev { transition: none; } }
