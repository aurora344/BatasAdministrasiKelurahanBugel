                var btn = L.DomUtil.create('button', 'legend-toggle', box);
                btn.type = 'button';
                btn.innerHTML = '<span>Legenda</span><span class="chev" aria-hidden="true">&#9660;</span>';
                btn.setAttribute('aria-expanded', !box.classList.contains('collapsed'));
                btn.onclick = function () {
                    box.classList.toggle('collapsed');
                    btn.setAttribute('aria-expanded', !box.classList.contains('collapsed'));
                };
                var body = L.DomUtil.create('div', 'legend-body', box);
                grupLegenda.forEach(function (g) {
                    var grp = L.DomUtil.create('div', 'lg-group', body);
                    L.DomUtil.create('div', 'lg-head', grp).textContent = g.judul;
                    g.item.forEach(function (it) {
                        var row = L.DomUtil.create('label', 'lg-item', grp);
